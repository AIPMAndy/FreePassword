[Unit]
Description=FreePassword Cloudflare Tunnel
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --config __CFG_DIR__/__TUNNEL__.yml run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
