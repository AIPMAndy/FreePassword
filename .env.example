# FreePassword 配置模板
# 复制为 .env 后修改；.env 已在 .gitignore 中，不会被提交

# 必填：最终访问地址，必须带 https:// 和完整域名
DOMAIN=https://vault.example.com

# 首次部署保持 true；注册完主账号后改为 false，并重建容器
SIGNUPS_ALLOWED=true

# 容器名与本机映射端口（只对 127.0.0.1 监听）
CONTAINER_NAME=vaultwarden
HOST_PORT=8081

TZ=Asia/Shanghai

# Cloudflare 隧道名（与 cloudflared tunnel create 时一致）
TUNNEL_NAME=freepassword

# 备份保留天数
BACKUP_KEEP_DAYS=30
